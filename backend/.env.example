# ==============================================================================
# CINE PLUS - Configuración de Entorno (Local y AWS)
# ==============================================================================

# Entorno de ejecución: 'development' o 'production'
FLASK_ENV=development

# Seguridad de sesiones
SECRET_KEY=cambia-esta-clave-secreta-en-produccion-por-un-valor-aleatorio
SESSION_LIFETIME_HOURS=12

# ------------------------------------------------------------------------------
# 1. Base de Datos MySQL (Local XAMPP o AWS RDS)
# ------------------------------------------------------------------------------
# Local XAMPP/MySQL:
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3307/cineplus?charset=utf8mb4

# AWS RDS Ejemplo (MySQL 8):
# DATABASE_URL=mysql+pymysql://admin:tu_password_rds@cineplus-db.c123456789.us-east-1.rds.amazonaws.com:3306/cineplus?charset=utf8mb4

# En AWS RDS poner en 1 para omitir intento de crear la BD con CREATE DATABASE (si ya fue creada en la consola):
SKIP_DB_BOOTSTRAP=0

# ------------------------------------------------------------------------------
# 2. AWS Secrets Manager (Opcional - Si se define, tiene prioridad sobre este .env)
# ------------------------------------------------------------------------------
# Nombre del secreto en AWS Secrets Manager (ej: cineplus/production)
# Si se deja vacío, la aplicación usará las variables locales de este archivo.
AWS_SECRET_NAME=
AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# 3. AWS S3 (Almacenamiento de Tráilers y Pósters)
# ------------------------------------------------------------------------------
# Nombre del bucket S3 (ej: cineplus-media-storage-estudiante)
# Si se deja vacío, los archivos se guardarán localmente en backend/uploads/
S3_BUCKET_NAME=

# ------------------------------------------------------------------------------
# 4. Proxy / Nginx / ALB
# ------------------------------------------------------------------------------
# Habilita el soporte para cabeceras X-Forwarded-For y X-Forwarded-Proto en EC2
BEHIND_PROXY=1

# ------------------------------------------------------------------------------
# 5. Credenciales del Administrador Inicial
# ------------------------------------------------------------------------------
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@cineplus.local
ADMIN_PASSWORD=cineplus123

# Límite máximo de subida para tráilers en MB (2048 MB = 2 GB)
MAX_UPLOAD_MB=2048
